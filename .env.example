# Copy this file to .env and fill in values
# NEVER commit .env to version control

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=

# Environment: development or production
FLASK_ENV=development

# Database Configuration
# -----------------------
# Option 1: Supabase (shared across team - RECOMMENDED)
# Get credentials from team lead or Supabase dashboard
# Use Session Pooler connection string (IPv4 compatible)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Option 2: Local Docker PostgreSQL (for offline development)
# DATABASE_URL=postgresql://brights:dev_password@db:5432/brights_db
# POSTGRES_USER=brights
# POSTGRES_PASSWORD=dev_password
# POSTGRES_DB=brights_db
